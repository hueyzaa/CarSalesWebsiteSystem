# =============================================
# EMAIL CONFIGURATION - Environment Variables
# File: .env (place in project root)
# =============================================

# SMTP Server (Gmail recommended for testing)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_AUTH=true
EMAIL_SMTP_STARTTLS=true

# Email Credentials
# IMPORTANT: Use App Password for Gmail
# Create: https://myaccount.google.com/apppasswords
EMAIL_USERNAME=carsaleswebsite.showroom@gmail.com
EMAIL_PASSWORD=vmig iasw jfce eotq

# Sender Info
EMAIL_FROM_ADDRESS=noreply@carshowroom.com
EMAIL_FROM_NAME=Car Showroom

# Settings
EMAIL_VERIFICATION_EXPIRY_HOURS=24
EMAIL_VERIFICATION_URL=http://localhost:8080/CarSalesWebsiteSystem/verify-email

# Email Subjects
EMAIL_SUBJECT_VERIFICATION=Xác thực email - Car Showroom
EMAIL_SUBJECT_WELCOME=Chào mừng đến với Car Showroom
EMAIL_SUBJECT_PASSWORD_RESET=Đặt lại mật khẩu - Car Showroom

# Debug Mode (true for development, false for production)
EMAIL_DEBUG=true

